APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Never deploy with debug enabled - it leaks stack traces, env vars and PHI
APP_DEBUG=false
APP_URL=http://localhost

# Encrypt session payloads (PHI-bearing sessions) at rest
SESSION_ENCRYPT=true
# Enable when serving over HTTPS; keep false for local HTTP development
SESSION_SECURE_COOKIE=false

# Database and other examples omitted for brevity...

# Mail - Gmail SMTP (outgoing mail: OTP codes, notifications)
# Requires 2-Step Verification + a 16-character App Password from
# https://myaccount.google.com/apppasswords (never use your login password).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=smtp.bhcis@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="smtp.bhcis@gmail.com"
MAIL_FROM_NAME="BHCIS Sta. Ana"

# ICD API configuration
# Set the API base URL (e.g. https://api.example.com) and token URL for
# client_credentials token exchange. If `BHCIS_ICD_API_ENABLED` is true and
# `BHCIS_ICD_API_BASE_URL` + `BHCIS_ICD_API_TOKEN_URL` are set, the app will
# query the remote ICD API for diagnosis lookups. Otherwise it will use the
# local `diagnosis_lookup` table.
BHCIS_ICD_API_ENABLED=true
BHCIS_ICD_API_BASE_URL=https://id.who.int
BHCIS_ICD_API_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
BHCIS_ICD_API_SEARCH_PATH=/search

# Obtain your own ICD API client credentials from WHO (id.who.int signing up)
# and set them here. Never commit real credentials to this file.
BHCIS_ICD_API_CLIENT_ID=
BHCIS_ICD_API_CLIENT_SECRET=
